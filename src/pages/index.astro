---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MediaCard from '../components/MediaCard.astro';
import { profile, highlights, skills, projects, media } from '../data/site';

const pageTitle = `${profile.name} · ${profile.title}`;
const pageDescription = profile.tagline;
---

<Layout title={pageTitle} description={pageDescription}>
	<Nav />

	<main class="mx-auto max-w-6xl px-5 pb-24 pt-28">
		<section class="reveal mb-24 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
			<div>
				<p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-[var(--color-accent)]">
					{profile.title}
				</p>
				<h1
					class="font-[family-name:var(--font-display)] text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Building <span class="text-gradient">production AI</span> systems that scale.
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">{profile.bio}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="#projects"
						class="rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[#0a0b0f] transition hover:brightness-110"
					>
						View projects
					</a>
					<a
						href={profile.github}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5"
					>
						GitHub
					</a>
				</div>
			</div>
			<div class="glass rounded-3xl p-6 lg:p-8">
				<p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">Focus areas</p>
				<ul class="mt-4 space-y-3 text-sm text-white/90">
					<li class="flex gap-3">
						<span class="text-[var(--color-accent)]">◆</span> Hybrid retrieval & reranking
					</li>
					<li class="flex gap-3">
						<span class="text-[var(--color-accent-2)]">◆</span> Agent orchestration & verification
					</li>
					<li class="flex gap-3">
						<span class="text-[var(--color-accent)]">◆</span> Golden-dataset evaluation & observability
					</li>
				</ul>
			</div>
		</section>

		<section id="about" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 max-w-2xl">
				<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">About</h2>
				<p class="mt-3 text-[var(--color-muted)]">{profile.tagline}</p>
			</div>
			<ul class="mb-10 grid gap-4 md:grid-cols-3">
				{
					highlights.map((line) => (
						<li class="glass rounded-2xl p-5 text-sm leading-relaxed text-white/85">{line}</li>
					))
				}
			</ul>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					skills.map((group) => (
						<div class="glass rounded-2xl p-5">
							<h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)]">
								{group.category}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{group.items.join(' · ')}</p>
						</div>
					))
				}
			</div>
		</section>

		<section id="projects" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
				<div>
					<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">Selected work</h2>
					<p class="mt-3 max-w-xl text-[var(--color-muted)]">
						Open-source pipelines and evaluation tooling for RAG, data engineering, and backend systems.
					</p>
				</div>
				<a
					href={profile.github}
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm font-medium text-[var(--color-accent)] hover:underline"
				>
					All repositories →
				</a>
			</div>
			<div class="grid gap-5 md:grid-cols-2">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</section>

		<section id="media" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 max-w-2xl">
				<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">Demos & video</h2>
				<p class="mt-3 text-[var(--color-muted)]">
					Walkthroughs of pipelines, eval harnesses, and agent flows—recordings and conference clips.
				</p>
			</div>
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{media.map((item) => <MediaCard item={item} />)}
			</div>
		</section>

		<section id="contact" class="reveal scroll-mt-28">
			<div class="glass relative overflow-hidden rounded-3xl px-8 py-12 text-center sm:px-12">
				<div
					class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[var(--color-accent)]/10 via-transparent to-[var(--color-accent-2)]/10"
					aria-hidden="true"
				>
				</div>
				<h2 class="relative font-[family-name:var(--font-display)] text-3xl font-bold text-white">
					Let’s build something reliable
				</h2>
				<p class="relative mx-auto mt-4 max-w-lg text-[var(--color-muted)]">
					Open to AI engineering roles and collaborations on RAG, agents, and data platforms.
				</p>
				<div class="relative mt-8 flex flex-wrap justify-center gap-3">
					<a
						href={profile.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#0a0b0f] transition hover:bg-white/90"
					>
						Connect on LinkedIn
					</a>
					<a
						href={profile.github}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5"
					>
						GitHub profile
					</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-white/5 py-8 text-center text-xs text-[var(--color-muted)]">
		<p>© {new Date().getFullYear()} {profile.name}. Hosted on GitHub Pages.</p>
	</footer>
</Layout>
