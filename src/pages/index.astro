---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, highlights, skills, projects, companies, projectCategories } from '../data/site';

const pageTitle = `${profile.name} · ${profile.title}`;
const pageDescription = profile.tagline;

const tagsByCategory: Record<string, string[]> = Object.fromEntries(
	projectCategories.map((cat) => [
		cat.id,
		[
			...new Set(
				projects.filter((p) => p.categories.includes(cat.id)).flatMap((p) => p.tags),
			),
		].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' })),
	]),
);

const categoryLabelById = Object.fromEntries(projectCategories.map((c) => [c.id, c.label]));
---

<Layout title={pageTitle} description={pageDescription}>
	<Nav />

	<main class="mx-auto max-w-6xl px-5 pb-24 pt-28">
		<section class="reveal mb-24 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
			<div>
				<p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-[var(--color-accent)]">
					{profile.title}
				</p>
				<h1
					class="font-[family-name:var(--font-display)] text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					<span class="text-gradient">AI Engineering</span> Portfolio
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">{profile.bio}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="#projects"
						class="rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[#0a0b0f] transition hover:brightness-110"
					>
						View projects
					</a>
					<a
						href={profile.github}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5"
					>
						GitHub
					</a>
				</div>
			</div>
			<div class="glass rounded-3xl p-6 lg:p-8">
				<p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">Focus areas</p>
				<ul class="mt-4 space-y-3 text-sm text-white/90">
					<li class="flex gap-3">
						<span class="text-[var(--color-accent)]">◆</span> Hybrid retrieval & reranking
					</li>
					<li class="flex gap-3">
						<span class="text-[var(--color-accent-2)]">◆</span> Agent orchestration & verification
					</li>
					<li class="flex gap-3">
						<span class="text-[var(--color-accent)]">◆</span> Golden-dataset evaluation & observability
					</li>
				</ul>
			</div>
		</section>

		<section id="projects" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
				<div>
					<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">Projects</h2>
					<p class="mt-3 max-w-xl text-[var(--color-muted)]">
						Browse by category—AI engineering labs, data pipelines, or APIs—or open a card to go to the repo on GitHub.
					</p>
				</div>
				<a
					href={profile.github}
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm font-medium text-[var(--color-accent)] hover:underline"
				>
					All repositories →
				</a>
			</div>
			<div
				class="mb-3 flex flex-wrap gap-2"
				id="project-category-filters"
				role="group"
				aria-label="Filter projects by category"
			>
				<button
					type="button"
					data-project-category="all"
					class="project-tag-filter is-active rounded-md border px-3 py-1.5 text-xs font-medium transition"
					aria-pressed="true"
				>
					All
				</button>
				{
					projectCategories.map((cat) => (
						<button
							type="button"
							data-project-category={cat.id}
							class="project-tag-filter rounded-md border px-3 py-1.5 text-xs font-medium transition"
							aria-pressed="false"
						>
							{cat.label}
						</button>
					))
				}
			</div>
			<div id="project-subtag-filters" class="project-subtag-panel" aria-hidden="true">
				<p id="project-subtag-label" class="mb-2 text-[11px] font-medium uppercase tracking-wider text-[var(--color-muted)]">
					Refine by tag
				</p>
				<div class="flex flex-wrap gap-2" id="project-subtag-buttons" role="group" aria-label="Refine category by tag"></div>
			</div>
			<script
				type="application/json"
				id="project-tags-by-category"
				set:html={JSON.stringify({ tagsByCategory, categoryLabelById })}
			/>
			<div id="project-grid" class="project-grid grid gap-5 md:grid-cols-2">
				{
					projects.map((project) => (
						<div
							class="project-card-wrap"
							data-project-categories={project.categories.join(',')}
							data-project-tags={project.tags.join(',')}
						>
							<ProjectCard project={project} />
						</div>
					))
				}
			</div>
			<p id="project-filter-empty" class="mt-4 hidden text-sm text-[var(--color-muted)]" role="status">
				No projects in this category. Try another filter.
			</p>
		</section>

		<script is:inline>
			(() => {
				const grid = document.getElementById('project-grid');
				const emptyMsg = document.getElementById('project-filter-empty');
				const subPanel = document.getElementById('project-subtag-filters');
				const subButtons = document.getElementById('project-subtag-buttons');
				const subLabel = document.getElementById('project-subtag-label');
				const metaEl = document.getElementById('project-tags-by-category');
				if (!grid || !metaEl || !subPanel || !subButtons) return;

				const meta = JSON.parse(metaEl.textContent || '{}');
				const tagsByCategory = meta.tagsByCategory || {};
				const categoryLabelById = meta.categoryLabelById || {};

				const items = grid.querySelectorAll('.project-card-wrap');
				const categoryButtons = document.querySelectorAll('[data-project-category]');

				let activeCategory = 'all';
				let activeTag = 'all';

				const FADE_MS = 220;

				function setCategoryActive(btn) {
					categoryButtons.forEach((b) => {
						const on = b === btn;
						b.setAttribute('aria-pressed', on ? 'true' : 'false');
						b.classList.toggle('is-active', on);
					});
				}

				function setSubtagActive(btn) {
					subButtons.querySelectorAll('[data-project-tag]').forEach((b) => {
						const on = b === btn;
						b.setAttribute('aria-pressed', on ? 'true' : 'false');
						b.classList.toggle('is-active', on);
					});
				}

				function buildSubtags(category) {
					subButtons.innerHTML = '';
					if (category === 'all') {
						subPanel.classList.remove('is-visible');
						subPanel.setAttribute('aria-hidden', 'true');
						return;
					}

					const tags = tagsByCategory[category] || [];
					const label = categoryLabelById[category] || category;
					if (subLabel) {
						subLabel.textContent = `Refine · ${label}`;
					}

					const allBtn = document.createElement('button');
					allBtn.type = 'button';
					allBtn.dataset.projectTag = 'all';
					allBtn.className = 'project-subtag-filter is-active rounded-md border px-2.5 py-1 text-[11px] font-medium transition';
					allBtn.setAttribute('aria-pressed', 'true');
					allBtn.textContent = 'All in category';
					subButtons.appendChild(allBtn);

					tags.forEach((tag) => {
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.dataset.projectTag = tag;
						btn.className = 'project-subtag-filter rounded-md border px-2.5 py-1 text-[11px] font-medium transition';
						btn.setAttribute('aria-pressed', 'false');
						btn.textContent = tag;
						subButtons.appendChild(btn);
					});

					subPanel.classList.add('is-visible');
					subPanel.setAttribute('aria-hidden', 'false');

					allBtn.addEventListener('click', () => onSubtagClick(allBtn, 'all'));
					subButtons.querySelectorAll('[data-project-tag]:not([data-project-tag="all"])').forEach((btn) => {
						btn.addEventListener('click', () =>
							onSubtagClick(btn, btn.getAttribute('data-project-tag') || 'all'),
						);
					});
				}

				function matches(item) {
					const categories = (item.getAttribute('data-project-categories') || '')
						.split(',')
						.map((t) => t.trim().toLowerCase());
					const tags = (item.getAttribute('data-project-tags') || '')
						.split(',')
						.map((t) => t.trim().toLowerCase());

					const catOk =
						activeCategory === 'all' || categories.includes(activeCategory.toLowerCase());
					const tagOk =
						activeTag === 'all' ||
						activeCategory === 'all' ||
						tags.includes(activeTag.toLowerCase());
					return catOk && tagOk;
				}

				function applyVisibility() {
					let visible = 0;
					items.forEach((item) => {
						const show = matches(item);
						item.classList.toggle('hidden', !show);
						if (show) visible += 1;
					});
					if (emptyMsg) emptyMsg.classList.toggle('hidden', visible > 0);
				}

				function runWithFade(updateFn) {
					grid.classList.add('is-swapping');
					window.setTimeout(() => {
						updateFn();
						applyVisibility();
						window.requestAnimationFrame(() => {
							grid.classList.remove('is-swapping');
						});
					}, FADE_MS);
				}

				function onSubtagClick(btn, tag) {
					activeTag = tag;
					setSubtagActive(btn);
					runWithFade(() => {});
				}

				categoryButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const category = btn.getAttribute('data-project-category') || 'all';
						setCategoryActive(btn);
						runWithFade(() => {
							activeCategory = category;
							activeTag = 'all';
							buildSubtags(category);
						});
					});
				});
			})();
		</script>

		<section id="companies" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 max-w-2xl">
				<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">Companies I worked with</h2>
				<p class="mt-3 text-[var(--color-muted)]">
					Selected organizations where I shipped production software—mobile, backend, data, and AI systems.
				</p>
			</div>
			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					companies.map((company) => (
						<li class="glass rounded-2xl p-5">
							<h3 class="font-[family-name:var(--font-display)] text-base font-semibold text-white">{company.name}</h3>
							{company.note && <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{company.note}</p>}
						</li>
					))
				}
			</ul>
		</section>

		<section id="achievements" class="reveal mb-24 scroll-mt-28">
			<div class="mb-10 max-w-2xl">
				<h2 class="font-[family-name:var(--font-display)] text-3xl font-bold text-white">Achievements</h2>
				<p class="mt-3 text-[var(--color-muted)]">{profile.tagline}</p>
			</div>
			<ul class="mb-10 grid gap-4 md:grid-cols-3">
				{
					highlights.map((line) => (
						<li class="glass rounded-2xl p-5 text-sm leading-relaxed text-white/85">{line}</li>
					))
				}
			</ul>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					skills.map((group) => (
						<div class="glass rounded-2xl p-5">
							<h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)]">
								{group.category}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{group.items.join(' · ')}</p>
						</div>
					))
				}
			</div>
		</section>

	</main>

	<footer class="border-t border-white/5 py-8 text-center text-xs text-[var(--color-muted)]">
		<p>© {new Date().getFullYear()} {profile.name}. Hosted on GitHub Pages.</p>
	</footer>
</Layout>
