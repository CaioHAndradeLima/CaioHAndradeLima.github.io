---
import type { Project } from '../data/site';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article
	class:list={[
		'glass group flex h-full flex-col rounded-2xl p-6 transition hover:border-white/15 hover:shadow-[0_0_40px_-12px_rgba(94,234,212,0.25)]',
		project.highlight && 'ring-1 ring-[var(--color-accent)]/20',
	]}
>
	<div class="mb-3 flex items-start justify-between gap-3">
		<h3 class="font-[family-name:var(--font-display)] text-lg font-semibold text-white">
			<a href={project.href} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)]">
				{project.name}
			</a>
		</h3>
		{
			project.highlight && (
				<span class="shrink-0 rounded-full bg-[var(--color-accent)]/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[var(--color-accent)]">
					Featured
				</span>
			)
		}
	</div>
	<p class="mb-5 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">{project.summary}</p>
	<ul class="flex flex-wrap gap-2">
		{
			project.tags.map((tag) => (
				<li class="rounded-md bg-white/5 px-2 py-1 text-[11px] text-white/70">{tag}</li>
			))
		}
	</ul>
</article>
